{
  "name": "coderssecret-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production --stats-json && node scripts/generate-sitemap.js && node scripts/generate-routes.js && node scripts/validate-generated-seo.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "check:vulnerabilities": "npm audit --audit-level=high --omit=dev",
    "check:build": "ng build --configuration production --stats-json",
    "check:performance": "node scripts/check-performance-budgets.js",
    "check:seo": "node scripts/check-seo.js",
    "check:internal-links": "node scripts/check-internal-content-links.js",
    "check:generated-seo": "node scripts/validate-generated-seo.js",
    "check:course-assets": "node scripts/validate-malware-course-assets.js",
    "check:ai-punctuation": "node scripts/check-ai-punctuation.js",
    "precommit": "run-s check:vulnerabilities check:course-assets test:ci build:prod check:performance check:seo check:internal-links check:ai-punctuation"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@angular/cdk": "^21.2.5",
    "@angular/common": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@spartan-ng/brain": "^0.0.1-alpha.660",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.17",
    "@angular/cli": "^21.2.17",
    "@angular/compiler": "^21.2.19",
    "@angular/compiler-cli": "^21.2.19",
    "@spartan-ng/cli": "^0.0.1-alpha.660",
    "@tailwindcss/postcss": "^4.2.2",
    "jsdom": "^28.0.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
